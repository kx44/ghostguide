{
  "name": "ghostguide-overlay",
  "version": "0.2.0",
  "private": true,
  "description": "GhostGuide overlay: transparent, click-through, always-on-top window that draws the guidance",
  "main": "out/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "node build.mjs && electron .",
    "replay": "node build.mjs && electron . --replay test/fixtures/youtube-clone-vscode.jsonl",
    "smoke": "node build.mjs && node test/smoke.mjs",
    "unit": "node test/unit.mjs",
    "dist": "node build.mjs && electron-builder --win portable"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/ws": "8.5.13",
    "electron": "38.4.0",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "ws": "8.18.0"
  }
}

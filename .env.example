# Copy to .env (gitignored) and fill in. Every value here can also be set as an environment variable.

# Meta API key (dev.meta.ai). Leave empty while building in replay mode.
META_API_KEY=
# Base URL and path of the chat endpoint (dev.meta.ai docs).
META_BASE_URL=https://api.meta.ai/v1
META_CHAT_PATH=/chat/completions

# live   = call the API (spends credits)
# record = call the API and save each response to cache/cassettes/
# replay = use saved responses only; spends nothing (default)
MODEL_MODE=replay

# Local spend cap in USD across all live/record calls (Meta has no hard cap, only a reminder at $5).
# The client refuses any call whose worst-case cost would take total logged spend over this.
BUDGET_USD=4.00

# Where Muse Glimmer runs: modal | spark-contributor | ollama (dev only; too slow on most laptops)
GLIMMER_BACKEND=modal
OLLAMA_HOST=http://127.0.0.1:11434
GLIMMER_OLLAMA_MODEL=muse-glimmer

# Model rungs of the step check (Glimmer on Modal, then Spark Contributor). Off by default: the free checks
# (accessibility rules, pixel diff) run first and decide most steps. on = use them when those can't tell.
CHECK_MODELS=off
# The deployed Glimmer endpoint on Modal (deploy/modal_glimmer.py) and its shared token (Modal secret glimmer-token).
GLIMMER_MODAL_URL=
GLIMMER_MODAL_TOKEN=
# Finder fallback: Spark vision on a screenshot when UI Automation can't find a control. Off by default.
FINDER_VISION=off
